# Copy this file to .env and adjust as needed. The Spring Boot app reads
# these as environment variables (see backend/src/main/resources/application.yml).
# These are development placeholders only. Set real values outside source
# control for any shared or deployed environment.

# --- Backend server ---
SERVER_PORT=8080

# --- PostgreSQL (transactional data: rooms, guests, bookings, transactions) ---
POSTGRES_DB=dynamicstay
POSTGRES_URL=jdbc:postgresql://localhost:5432/dynamicstay
POSTGRES_USER=dynamicstay
POSTGRES_PASSWORD=replace-with-local-postgres-password

# --- MongoDB (occupancy event logs, guest reviews) ---
MONGO_DB=dynamicstay
MONGO_USER=replace-with-mongo-user
MONGO_PASSWORD=replace-with-mongo-password
MONGO_URI=mongodb://localhost:27017/dynamicstay

# --- Authentication (BCrypt encoded in memory at startup) ---
DYNAMICSTAY_MANAGER_USERNAME=manager
DYNAMICSTAY_MANAGER_PASSWORD=replace-with-a-local-manager-password
DYNAMICSTAY_ADMIN_USERNAME=admin
DYNAMICSTAY_ADMIN_PASSWORD=replace-with-a-local-admin-password

# Comma-separated browser origins. Never use * in a deployed environment.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional pricing overrides. Defaults preserve the deterministic demo model.
PRICING_ENGINE_LAST_MINUTE_THRESHOLD_DAYS=3
PRICING_ENGINE_HIGH_OCCUPANCY_THRESHOLD=0.70

# --- Frontend ---
# Base URL the dashboard's js/api.js should call. Override via
# window.DYNAMICSTAY_API_BASE in index.html if you deploy the backend elsewhere.
DYNAMICSTAY_API_BASE=http://localhost:8080/api

# --- Selenium tests ---
# Base URL of the running frontend (e.g. `python -m http.server 5500` inside /frontend)
DYNAMICSTAY_SELENIUM_BASE_URL=http://localhost:5500
# Set to false to watch the browser instead of running headless
DYNAMICSTAY_SELENIUM_HEADLESS=true
