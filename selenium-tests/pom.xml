<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dynamicstay</groupId>
    <artifactId>dynamicstay-selenium-tests</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>DynamicStay Selenium E2E Tests</name>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <selenium.version>4.23.0</selenium.version>
        <junit.version>5.10.3</junit.version>
        <webdrivermanager.version>5.9.2</webdrivermanager.version>
        <dynamicstay.baseUrl>http://localhost:5500</dynamicstay.baseUrl>
        <dynamicstay.username>manager</dynamicstay.username>
        <dynamicstay.password>local-manager-change-me</dynamicstay.password>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- Auto-downloads/manages the correct chromedriver binary -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <dynamicstay.baseUrl>${dynamicstay.baseUrl}</dynamicstay.baseUrl>
                        <dynamicstay.username>${dynamicstay.username}</dynamicstay.username>
                        <dynamicstay.password>${dynamicstay.password}</dynamicstay.password>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
